{
  "policy_version": 1,
  "limits": {
    "event_name": 50,
    "property_count": 40,
    "property_name": 64,
    "string_value": 200,
    "number_absolute": 1000000000000,
    "number_decimal_places": 4,
    "subject_id": 50,
    "page_path": 300,
    "page_title": 120
  },
  "common_properties": [
    "event_version",
    "product",
    "environment",
    "surface",
    "product_version",
    "sdk_version",
    "platform",
    "architecture",
    "locale",
    "channel",
    "access_type",
    "consent_state",
    "policy_version"
  ],
  "session_properties": [
    "plan",
    "role_category",
    "channel",
    "account_age_bucket",
    "license_category"
  ],
  "forbidden_key_tokens": [
    "prompt",
    "response",
    "reply",
    "chat",
    "code",
    "source",
    "file",
    "filename",
    "filepath",
    "path",
    "command",
    "cmd",
    "argument",
    "args",
    "environment_variable",
    "env_var",
    "token",
    "secret",
    "password",
    "cookie",
    "authorization",
    "email",
    "phone",
    "name",
    "address",
    "clipboard",
    "screen_content",
    "document",
    "stack",
    "stacktrace",
    "log",
    "request_body",
    "request_header"
  ],
  "sensitive_value_patterns": [
    "(?i)\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b",
    "(?i)\\bBearer\\s+[A-Za-z0-9._~+/-]+=*",
    "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "(?i)\\b(?:sk|ghp|gho|github_pat|xoxb|xoxp)[-_][A-Za-z0-9_-]{16,}\\b",
    "\\bAKIA[0-9A-Z]{16}\\b",
    "(?i)^[A-Z]:\\\\",
    "^/(?:Users|home|root|etc|var)/",
    "^\\\\\\\\[^\\\\]+\\\\[^\\\\]+"
  ],
  "allowed_url_query_keys": [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_content",
    "utm_term"
  ]
}
