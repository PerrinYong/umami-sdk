{
  "name": "@perrin-yong/umami-sdk",
  "version": "0.1.1",
  "description": "Thin, privacy-first Umami SDK for Pystone products",
  "license": "UNLICENSED",
  "author": "Perrin Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerrinYong/umami-sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/PerrinYong/umami-sdk#readme",
  "bugs": {
    "url": "https://github.com/PerrinYong/umami-sdk/issues"
  },
  "keywords": [
    "umami",
    "analytics",
    "telemetry",
    "privacy",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "files": [
    "dist/core",
    "dist/web",
    "dist/node",
    "README.md"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "5.9.3"
  }
}
